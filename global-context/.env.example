# Sarvam AI key from dashboard.sarvam.ai (enables Sarvam-105B, Bulbul TTS, Saaras STT)
SARVAM_API_KEY=

# Sarvam Voice Agents ("Samvaad") key — indus.sarvam.ai → Settings → API Keys (not the same key as above)
SARVAM_SAMVAAD_API_KEY=
# secret for the public tunnel (Sarvam agent tools + outbound webhook use ?token=)
GCX_TUNNEL_TOKEN=
# public HTTPS URL of this server for the phone-call webhook (cloudflared/ngrok), e.g. https://x.trycloudflare.com
GCX_PUBLIC_URL=
# Real phone calls (Instant Outbound), from indus.sarvam.ai → Deploy → Phone Numbers. Not secret — these can
# also live in config.yaml → samvaad. Without both, `gcx call` and /api/phone-call refuse to dial.
GCX_SAMVAAD_CONNECTION_ID=
GCX_SAMVAAD_AGENT_PHONE_NUMBER=

# Optional fallback LLM (any OpenAI-compatible endpoint) — set base_url/model in config.yaml
FALLBACK_LLM_API_KEY=

# Any config.yaml value can be overridden, e.g.
# GCX_TOKEN_BUDGET=450
# GCX_DATA_DIR=data/raw
